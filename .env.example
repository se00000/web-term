# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 저장소에 올리지 않습니다.

# 서버 포트 (JCloud에서 열어둔 포트에 맞춥니다)
PORT=3000

# 외부 접속을 받으려면 0.0.0.0, 로컬에서만 쓰려면 127.0.0.1
HOST=0.0.0.0

# JWT 서명 키. 32자 이상 임의 문자열 (예: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# SQLite 파일 경로 (비우면 data/app.sqlite)
DB_PATH=

# npm run db:seed 가 만드는 시연용 계정의 공통 비밀번호 (8자 이상)
SEED_PASSWORD=
